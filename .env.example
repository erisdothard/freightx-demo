# ─────────────────────────────────────────────
# FreightX Environment Variables
# ─────────────────────────────────────────────
# Copy this file to apps/web/.env.local
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# Supabase (required)
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (required for Phase 5+)
# Get from: dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# FMCSA API (required for Phase 5 carrier verification)
# Register free at: portal.fmcsa.dot.gov/Developer/
VITE_FMCSA_API_KEY=

# Mapbox (required — for map rendering + geocoding)
# Get from: account.mapbox.com → Tokens → Create a token (or use default public token)
# Free tier: 50,000 map loads/month
VITE_MAPBOX_TOKEN=

# Google Maps (optional — legacy, replaced by Mapbox)
VITE_GOOGLE_MAPS_API_KEY=

# Sentry (optional — for error monitoring in production)
# Get from: sentry.io → your project → Settings → DSN
VITE_SENTRY_DSN=

# App URL (used for OAuth redirects, email links)
VITE_APP_URL=http://localhost:5173

# Upstash Redis (required for Phase 6.5+ rate limiting)
# Sign up at: https://upstash.com (free tier available)
VITE_UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-token-here

# Anthropic API (required for AI load search — supabase/functions/ai-load-search)
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Web Push / VAPID (required for Phase 18 push notifications)
# Generate with: node -e "require('crypto').subtle..." or use web-push CLI
# Public key goes here (safe to expose); private key goes in Supabase secrets only
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Google Calendar OAuth 2.0 (required for calendar sync — Feature 5)
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Scope: https://www.googleapis.com/auth/calendar.events
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project-ref.supabase.co/functions/v1/google-oauth-callback

# Supabase CLI personal access token (for deploying edge functions locally)
# Get from: supabase.com/dashboard/account/tokens
# Used only in local dev — never commit a real token
SUPABASE_ACCESS_TOKEN=your-access-token-here